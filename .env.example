# Пример окружения: скопируй в .env и заполни. Значения с меткой CHANGE_ME в боевом
# режиме не принимаются — процесс не стартует и называет все такие переменные разом.

# Режим: dev | test | prod
APP_ENV=dev
SERVICE_NAME=ai-geo-audit

# База и очередь; в бою задаются явно.
# pragma: allowlist nextline secret
DATABASE_URL=postgresql+asyncpg://audit:CHANGE_ME@localhost:5462/audit
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
DB_ECHO_SQL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_TASK_POOL_SIZE=2
# Сколько второй migrate ждёт замка первого, в секундах (от 1 до 3600).
MIGRATION_LOCK_WAIT_SECONDS=120

# Вход: секрет подписи пропусков (openssl rand -hex 32) и срок жизни пропуска в часах.
JWT_SECRET=CHANGE_ME
JWT_TTL_HOURS=12

# Файл мастер-ключа ключей сервисов; монтируется только в api и воркер.
KEYS_MASTER_KEY_FILE=CHANGE_ME

# Тревоги: токен бота и номер чата Telegram — в бою обязательны у api; номер группы — с минусом.
ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME
ALERT_TELEGRAM_CHAT_ID=CHANGE_ME

# Вход API: адрес и порт процесса api; доверенные прокси — адреса и сети через запятую, не
# шире /16 у IPv4 и /64 у IPv6. В бою API_TRUSTED_PROXIES задаётся явно — адрес web.
API_HOST=127.0.0.1
API_PORT=8107
API_TRUSTED_PROXIES=127.0.0.1

# Логи: text | json; уровень DEBUG | INFO | WARNING | ERROR.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Сервер и стек compose: на сервере это файл /srv/ai-geo-audit/.env, его создаёт
# `deploy.py env-init`; на машине стека — раскомментируйте и заполните. Процессы сервиса эти имена
# не читают — их подставляет compose. DB_PASSWORD — пароль суперпользователя базы, он только у
# db. Пароли ролей тоже только у db: роли заводит deploy/db/roles.sql (README, «Роли базы»).
# Адрес migrate — роль audit_migrate и её пароль, адрес api — роль audit_app и её пароль (не
# короче 12 знаков, @ / ? # — закодированными); адрес web — единственный доверенный прокси api;
# файл мастер-ключа — на машине, в api он приходит секретом. REDIS_PASSWORD — пароль очереди, он
# только у redis; адрес очереди api — тот же пароль (те же правила длины и знаков). WEB_PORT —
# порт web на петле машины; FRONT_SUBNET — подсеть сети front, /28 вне пулов докера;
# WEB_ADDRESS — постоянный адрес web в ней. SITE_DOMAIN и NEIGHBOR_HEALTH_URLS читает только
# скрипт выката. Строка «## пометка» говорит, кто задаёт значения под ней: «создаёт скрипт» —
# env-init, случайными; «задаёт владелец» — put-secret, файлом; «пишет выкат» — up.
## создаёт скрипт
# DB_PASSWORD=CHANGE_ME
# POSTGRES_MIGRATE_PASSWORD=CHANGE_ME
# POSTGRES_APP_PASSWORD=CHANGE_ME
# REDIS_PASSWORD=CHANGE_ME
# pragma: allowlist nextline secret
# MIGRATE_DATABASE_URL=postgresql+asyncpg://audit_migrate:CHANGE_ME@db:5432/audit
# pragma: allowlist nextline secret
# API_DATABASE_URL=postgresql+asyncpg://audit_app:CHANGE_ME@db:5432/audit
# API_REDIS_URL=redis://:CHANGE_ME@redis:6379/0
# JWT_SECRET=CHANGE_ME
# KEYS_MASTER_KEY_HOST_FILE=CHANGE_ME
## задаёт владелец
# SITE_DOMAIN=CHANGE_ME
# WEB_PORT=CHANGE_ME
# FRONT_SUBNET=CHANGE_ME
# WEB_ADDRESS=CHANGE_ME
# NEIGHBOR_HEALTH_URLS=CHANGE_ME
# ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME
# ALERT_TELEGRAM_CHAT_ID=CHANGE_ME
## пишет выкат
# BACKEND_IMAGE=
# WEB_IMAGE=
