# Static dependency direction enforcement (import-linter).
# Запуск: lint-imports (из каталога с этим конфигом, обычно backend/).
# Стратегия: enforce то, что уже соблюдается; расширять по мере добавления слоёв.
# Легаси-нарушения выносить в ignore_imports с пометкой "TODO: PROJ-123" (свой тикет).
# ⚠ Номер тикета стоит ПРИМЕРОМ, а не угловыми скобками со словом внутри, и это не
# стиль: gate-coverage ищет в конфигах контура именно такую форму — незаполненный
# шаблон, — и комментарии считает намеренно (закомментированная дыра шаблона это
# всё та же дыра). Пока пояснение было написано той формой, правильно развёрнутый
# проект всё равно получал красный гейт: подставить в пояснение нечего. Держит
# tests/test_deployment_procedure.py — и по той же причине эта врезка обходится
# без угловых скобок, иначе она наказывала бы сама себя.
#
# Пакет — ai_geo_audit (раскладка backend/src). Контракты 1 и 3 примера канона не заведены, и
# это объявлено в scripts/lint/adapted.json: пакета интеграций нет, а «модели не импортируют
# верхние слои» держит контракт слоёв ниже — storage стоит под api.

[importlinter]
root_packages =
    ai_geo_audit

# --------------------------------------------------------------------
# Контракт: слои пакета сверху вниз — вход API, настройки из базы, хранилище, тревоги, логи,
# конфиг окружения, отказ. Верхний слой импортирует нижние, обратно нельзя. Слой `api`
# обязательный (A95): слой назван, а пакета нет — красный «Missing layer in container». Слой
# `settings` (Ч1.12а) — между `api` и `storage`: разбор файла мастер-ключа поэтому лежит в `config`.
# Слой `alerts` (Ч1.14а1, В5) — между `storage` и `logs`: тревоги кладут хранилище и настройки, а
# сами зовут только конфиг, логи и Redis. Команды `ops` — вне слоёв.
# Справочник `reference` (Ч2.1) — независимый сосед `settings` в одном слое: оба стоят на
# `storage` и ниже, друг друга не импортируют (проба 4 шага 0: `|` import-linter 2.15 судит).
# --------------------------------------------------------------------
[importlinter:contract:ai-geo-audit-layered]
name = ai_geo_audit: api -> settings -> storage -> alerts -> logs -> config -> refusal
type = layers
layers =
    api
    settings | reference
    storage
    alerts
    logs
    config
    refusal
containers =
    ai_geo_audit
exhaustive = False
