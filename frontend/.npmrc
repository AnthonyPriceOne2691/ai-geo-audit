# Только реестр npm: настройка машины не меняет адресов пакетов в lock (F17).
registry=https://registry.npmjs.org/
# Node — из engines: на другой версии npm ci отказывает (F1).
engine-strict=true
# Скрипты установки пакетов не исполняются (F17); пакеты со скриптом — поимённо в
# approved-packages.json, с причиной, почему цепочка работает без него.
ignore-scripts=true
# Новый пакет записывается точной версией.
save-exact=true
# Версии моложе 14 суток не берутся (F17): свежий выпуск — главный путь подмены пакета.
# Решение проверяющего 2026-11-19; npm ci не трогает — там версии из lock.
min-release-age=14
